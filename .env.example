# PostgreSQL connection string supplied by Render. Images and all editable site content live here.
DATABASE_URL=postgresql://user:password@host:5432/alfadiagnostic
# Long, private passcode used only to unlock /admin.
ADMIN_PASSCODE=replace-with-a-long-private-passcode
# Random secret for signed administrator sessions.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional: leave empty in development. Use the public Render URL in production.
PUBLIC_ORIGIN=

